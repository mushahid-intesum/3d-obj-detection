# ESP32-S3 defaults for MCU ImageNav
CONFIG_IDF_TARGET="esp32s3"

# PSRAM (required for camera DMA buffers)
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Camera
CONFIG_CAMERA_TASK_STACK_SIZE=4096

# WiFi
CONFIG_ESP_WIFI_SSID="YOUR_SSID"
CONFIG_ESP_WIFI_PASSWORD="YOUR_PASS"

# Partition table: default with enough space
CONFIG_PARTITION_TABLE_CUSTOM=n

# Increase main task stack for init
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
